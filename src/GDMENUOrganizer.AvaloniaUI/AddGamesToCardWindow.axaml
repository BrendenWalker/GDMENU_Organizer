<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="GDMENUOrganizer.AddGamesToCardWindow"
        Title="Add Games to Card" Height="420" Width="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0 0 0 8" Text="Select games from the library to add to this card." />

    <DataGrid Grid.Row="1" Name="dgLibrary"
              ItemsSource="{Binding AvailableGames, Mode=OneWay}"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True" CanUserSortColumns="True" CanUserReorderColumns="False"
              SelectionMode="Extended" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Title" Width="2*" Binding="{Binding Name}" />
        <DataGridTextColumn Header="Serial" Width="Auto" Binding="{Binding ProductNumber}" />
        <DataGridTextColumn Header="Disc" Width="Auto" Binding="{Binding Ip.Disc}" />
        <DataGridTextColumn Header="Status" Width="Auto" Binding="{Binding SyncStatusDisplay}" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
      <Button Content="Cancel" MinWidth="90" Padding="12 8" Click="ButtonCancel_Click" IsCancel="True" />
      <Button Content="Add" MinWidth="90" Padding="12 8" Click="ButtonAdd_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
