#!/usr/bin/env bash
# Strips tool/vendor attribution trailers from commit messages.
# Enable once per clone: git config core.hooksPath .githooks

set -euo pipefail
msg_file="$1"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

grep -v -E \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*(Cursor|Claude|.*cursoragent@|.*noreply@anthropic)' \
  -e '^[[:space:]]*Made-with:[[:space:]]*' \
  -e '^[[:space:]]*Made with Cursor' \
  -e '^[[:space:]]*Generated by[[:space:]]' \
  -e '^[[:space:]]*Generated with[[:space:]]' \
  "$msg_file" > "$tmp" || true

# Remove trailing blank lines
awk '
  { lines[NR] = $0 }
  END {
    end = NR
    while (end > 0 && lines[end] ~ /^[[:space:]]*$/) end--
    for (i = 1; i <= end; i++) print lines[i]
  }
' "$tmp" > "$msg_file"
