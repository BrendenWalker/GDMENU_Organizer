<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="180"
        x:Class="GDMENUOrganizer.TextInputWindow"
        Title="Input" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="14">
    <TextBlock Name="tbHeader" TextWrapping="Wrap" FontWeight="SemiBold" />

    <StackPanel Spacing="6">
      <TextBlock Text="Name" />
      <TextBox Name="tbInput" MinHeight="32" MaxLength="100" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 4 0 0">
      <Button Name="btnCancel" Content="Cancel" MinWidth="90" Padding="12 8"
              IsCancel="True" Click="ButtonCancel_Click" />
      <Button Name="btnOk" Content="Ok" MinWidth="90" Padding="12 8"
              IsDefault="True" Click="ButtonOk_Click" />
    </StackPanel>
  </StackPanel>
</Window>
